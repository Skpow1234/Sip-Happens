# Staging stack. Copy to .env.staging and fill secrets.
#   COMPOSE_PROJECT_NAME=sip-happens-staging \
#     docker compose -f infra/compose.yaml -f infra/compose.staging.yaml --env-file .env.staging up -d

NAMESPACE=staging
ADMIN_TOKEN=change-me-staging
STRIPE_MOCK=1
OUTBOX_PUBLISHER=nats
NATS_URL=nats://nats:4222
NATS_STREAM=sip_happens

# Optional when running staging beside dev on the same host (with compose.dev.yaml):
# SIP_HAPPENS_HTTP_PORT=8081
# SIP_HAPPENS_SSH_PORT=2223
