# Copy to repo root as .env.prod and fill before:
#   docker compose -f infra/compose.yaml -f infra/compose.prod.yaml --env-file .env.prod up -d
#
# Postgres (used by compose.prod env_file on the postgres service)
POSTGRES_USER=beer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=beer_shop

# core-api / jobs (override compose defaults)
POSTGRES_DSN=postgres://beer:change-me@postgres:5432/beer_shop?sslmode=disable
ADMIN_TOKEN=change-me
ADMIN_SUPPORT_TOKENS=
ADMIN_FINANCE_TOKENS=
CORE_API_HMAC_KEY_ID=prod
CORE_API_HMAC_KEYS=prod:change-me-hmac-secret
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MOCK=0
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222
NAMESPACE=prod
OUTBOX_PUBLISHER=nats

# ssh-gateway (published as host SIP_HAPPENS_SSH_PORT → container 2222)
SIP_HAPPENS_SSH_PORT=2222
SSH_REQUIRE_AUTHORIZED_KEYS=1
SSH_DISABLE_PASSWORD_AUTH=1
SSH_DISABLE_PORT_FORWARDING=1
# Mount or copy authorized_keys into the sshkeys volume at /data/authorized_keys
# (see docs/ops/ssh-production.md). Do not set SSH_DEV_FINGERPRINT in prod.
