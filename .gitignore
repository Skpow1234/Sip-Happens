# Docker local overrides
docker-compose.override.yml

.cursorrules
# Private design notes (keep out of the public tree). Everything else under docs/ is tracked.
docs/DESIGN.md
services/ssh-gateway/entrypoint.sh

# Demo SSH private keys are committed on purpose (passphrase-empty, local-only).
# They pair with authorized_keys + SSH_DEV_FINGERPRINT so a fresh clone can
# `ssh -F infra/demo/ssh_config sip-happens` without regenerating the keypair.
# Do not reuse these keys outside local Compose.
infra/docker
